VOICE_API_ORIGIN=https://your-resource.openai.azure.com
PORT=3000
HOSTNAME=0.0.0.0
WEB_PORT=3000
WEB_IMAGE_TAG=dev
# Non-secret, build-time Masumi/Sokosumi service origin for /paid status routes.
CARDANO_BASE_URL=http://127.0.0.1:8096
SOKOSUMI_PREPROD_URL=https://preprod.sokosumi.com

WALLET_CONNECT_ORIGINS=http://localhost:3301,http://localhost:3321,https://localhost:2121

# Historical x402 provider only; not required by the selected Masumi flow.
CARDANO_KOIOS_URL=https://preprod.koios.rest/api/v1
